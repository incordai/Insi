+//! Insi delegates edits to the existing audit coder; owner/proxy approval binds the scope.
+use crate::*;
+use serde::{Deserialize, Serialize};
+use std::path::{Path, PathBuf};
+
+#[derive(Clone, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct CandidateRequest {
+    pub project: String,
+    pub candidate: String,
+    pub baseline: String,
+    pub finding_updated_at: i64,
+    #[serde(default)]
+    pub approval_token: String,
+}
+
+fn git_at(root: &Path, args: &[&str]) -> Result<String, String> {
+    let out = std::process::Command::new("git")
+        .arg("--no-pager")
+        .args(args)
+        .current_dir(root)
+        .output()
+        .map_err(|e| e.to_string())?;
+    if !out.status.success() {
+        return Err("candidate Git validation failed".into());
+    }
+    Ok(String::from_utf8_lossy(&out.stdout).trim().into())
+}
+
+fn scope(
+    request: &CandidateRequest,
+    finding: &crate::audit::Finding,
+) -> Result<(PathBuf, PathBuf, String), String> {
+    if finding.category != crate::audit::FindingCategory::Improvement
+        || finding.status != crate::audit::FindingStatus::Approved
+        || finding.updated_at != request.finding_updated_at
+    {
+        return Err("finding must be an approved improvement at the requested revision".into());
+    }
+    if request.baseline.len() != 40 || !request.baseline.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err("invalid baseline commit".into());
+    }
+    let root = std::fs::canonicalize(&request.project).map_err(|e| e.to_string())?;
+    let candidate = std::fs::canonicalize(&request.candidate).map_err(|e| e.to_string())?;
+    let allowed = [root.join(".insi-work"), root.join(".incord").join("temp")];
+    if candidate == root
+        || !allowed.iter().any(|p| candidate.starts_with(p))
+        || !candidate.join(".git").is_dir()
+    {
+        return Err(
+            "candidate must be an isolated clone under project .insi-work or .incord/temp".into(),
+        );
+    }
+    // A redirected Git directory could turn validation or backups into original-tree writes.
+    let git_meta = std::fs::symlink_metadata(candidate.join(".git")).map_err(|e| e.to_string())?;
+    #[cfg(windows)]
+    let reparse = {
+        use std::os::windows::fs::MetadataExt;
+        git_meta.file_attributes() & 0x400 != 0
+    };
+    #[cfg(not(windows))]
+    let reparse = false;
+    if git_meta.file_type().is_symlink() || reparse {
+        return Err("candidate Git directory is a symlink".into());
+    }
+    let original = std::fs::canonicalize(&finding.file).map_err(|e| e.to_string())?;
+    let relative = original
+        .strip_prefix(&root)
+        .map_err(|_| "finding is outside the original project")?;
+    let target = std::fs::canonicalize(candidate.join(relative)).map_err(|e| e.to_string())?;
+    if !target.starts_with(&candidate) {
+        return Err("candidate target escapes its checkout".into());
+    }
+    if git_at(&root, &["rev-parse", "HEAD"])? != request.baseline {
+        return Err("original baseline moved".into());
+    }
+    let changed = git_at(
+        &candidate,
+        &["diff", "--name-only", &request.baseline, "HEAD"],
+    )?;
+    if changed.lines().any(|p| !p.starts_with(".insi-bench/"))
+        || !git_at(&candidate, &["status", "--porcelain"])?.is_empty()
+    {
+        return Err("candidate contains changes beyond the frozen benchmarks".into());
+    }
+    if std::fs::read(&original).map_err(|e| e.to_string())?
+        != std::fs::read(&target).map_err(|e| e.to_string())?
+    {
+        return Err("candidate finding source differs from the original".into());
+    }
+    let mut binding = request.clone();
+    binding.approval_token.clear();
+    let bytes = serde_json::to_vec(&(
+        finding,
+        binding,
+        blake3::hash(&std::fs::read(&target).map_err(|e| e.to_string())?)
+            .to_hex()
+            .to_string(),
+    ))
+    .map_err(|e| e.to_string())?;
+    Ok((
+        candidate,
+        target,
+        format!("insi-candidate:{}", blake3::hash(&bytes).to_hex()),
+    ))
+}
+
+/// Approval is an existing owner/proxy record, never a caller-provided boolean.
+fn approved(row: &crate::owner_web::StoredDecision, key: &str, project: &str, now: i64) -> bool {
+    row.consumed
+        && row.verb == "approve"
+        && row.dedup_key == key
+        && row.project == project
+        && row.expires_at >= now
+}
+
+fn settings_key(binding: &str, settings: &crate::audit::AuditSettings) -> String {
+    format!(
+        "insi-candidate:{}",
+        blake3::hash(
+            format!(
+                "{binding}:{}",
+                serde_json::to_string(settings).unwrap_or_default()
+            )
+            .as_bytes()
+        )
+        .to_hex()
+    )
+}
+
+pub(crate) async fn candidate_prepare(
+    State(state): State<AppState>,
+    headers: HeaderMap,
+    axum::extract::Path(id): axum::extract::Path<String>,
+    Json(request): Json<CandidateRequest>,
+) -> Result<Json<serde_json::Value>, (StatusCode, Json<ErrorBody>)> {
+    let ctx = require_ctx_or_err(&headers, &state)?;
+    resolve_user_local(&ctx, "")?;
+    let finding = crate::project_stores::findings::get(&state.layout, &id)
+        .map_err(|e| err(StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?
+        .ok_or_else(|| err(StatusCode::NOT_FOUND, "finding not found"))?;
+    let (candidate, _, binding) =
+        scope(&request, &finding).map_err(|e| err(StatusCode::CONFLICT, e))?;
+    let settings = state
+        .settings
+        .audit_settings()
+        .map_err(|e| err(StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?;
+    if !settings.enabled
+        || settings.auto_apply
+        || settings.file_paused(&finding.file)
+        || settings.source != crate::audit::AuditSource::Cli
+        || settings.test_command.trim().is_empty()
+    {
+        return Err(err(StatusCode::CONFLICT,"enable the audit CLI coder, disable original-tree auto_apply and configure its test command; no service/API model fallback"));
+    }
+    let binding = settings_key(&binding, &settings);
+    let item=crate::owner_web::DecisionItem {id:format!("insi:{}:{binding}",finding.id),title:"Allow Insi's isolated improvement candidate".into(),detail:format!("Finding: {} at revision {}. Original: {}. Candidate: {}. Baseline: {}. Only the existing audit coder may edit the candidate; gate: {}. Insi must independently pass frozen benchmarks before proposing a draft PR. This does not approve publication or merge.",finding.id,finding.updated_at,request.project,candidate.display(),request.baseline,settings.test_command),source:"forward".into(),project:request.project.clone(),severity:3,dedup_key:binding,..Default::default()};
+    let Json(decision) =
+        crate::api::owner::post_owner_enqueue(State(state), headers, Json(item)).await?;
+    let token = decision["token"]
+        .as_str()
+        .filter(|t| !t.is_empty())
+        .ok_or_else(|| {
+            err(
+                StatusCode::CONFLICT,
+                "owner/proxy console has no reachable answer path; candidate not executed",
+            )
+        })?;
+    Ok(Json(
+        serde_json::json!({"status":"approval-requested","token":token,"finding":finding.id}),
+    ))
+}
+
+pub(crate) async fn candidate_execute(
+    State(state): State<AppState>,
+    headers: HeaderMap,
+    axum::extract::Path(id): axum::extract::Path<String>,
+    Json(request): Json<CandidateRequest>,
+) -> Result<Json<serde_json::Value>, (StatusCode, Json<ErrorBody>)> {
+    let ctx = require_ctx_or_err(&headers, &state)?;
+    resolve_user_local(&ctx, "")?;
+    let mut finding = crate::project_stores::findings::get(&state.layout, &id)
+        .map_err(|e| err(StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?
+        .ok_or_else(|| err(StatusCode::NOT_FOUND, "finding not found"))?;
+    let (candidate, target, binding) =
+        scope(&request, &finding).map_err(|e| err(StatusCode::CONFLICT, e))?;
+    let now = chrono::Utc::now().timestamp();
+    let initial_settings = state
+        .settings
+        .audit_settings()
+        .map_err(|e| err(StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?;
+    let binding = settings_key(&binding, &initial_settings);
+    let rows = state
+        .settings
+        .owner_pending_scoped(&console_scope(&ctx, &state)?.scope)
+        .map_err(|e| err(StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?;
+    if !rows
+        .iter()
+        .any(|r| r.token == request.approval_token && approved(r, &binding, &request.project, now))
+    {
+        return Err(err(
+            StatusCode::FORBIDDEN,
+            "matching unexpired owner/proxy approval required",
+        ));
+    }
+    let mut settings = initial_settings;
+    if !settings.enabled
+        || settings.auto_apply
+        || settings.file_paused(&finding.file)
+        || settings.source != crate::audit::AuditSource::Cli
+        || settings.test_command.trim().is_empty()
+    {
+        return Err(err(
+            StatusCode::CONFLICT,
+            "audit CLI execution is unavailable or original-tree auto_apply is enabled",
+        ));
+    }
+    let lock = candidate.join(".git/insi-candidate.lock");
+    let mut lease = std::fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&lock)
+        .map_err(|_| {
+            err(
+                StatusCode::CONFLICT,
+                "candidate already claimed; inspect its retained lock before retry",
+            )
+        })?;
+    use std::io::Write;
+    lease
+        .write_all(
+            serde_json::to_string(&request)
+                .map_err(|e| err(StatusCode::BAD_REQUEST, e.to_string()))?
+                .as_bytes(),
+        )
+        .map_err(|e| err(StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?;
+    lease
+        .sync_all()
+        .map_err(|e| err(StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?;
+    // Retain the claim across errors/restarts; no automatic second model invocation.
+    settings.test_cwd = candidate.to_string_lossy().into_owned();
+    settings.folders = vec![settings.test_cwd.clone()];
+    let original =
+        std::fs::read(&finding.file).map_err(|e| err(StatusCode::CONFLICT, e.to_string()))?;
+    let result = crate::audit::apply_candidate(&state, &settings, &finding, &target, &candidate)
+        .await
+        .map_err(|e| err(StatusCode::BAD_REQUEST, e.to_string()))?;
+    if std::fs::read(&finding.file).map_err(|e| err(StatusCode::CONFLICT, e.to_string()))?
+        != original
+    {
+        return Err(err(
+            StatusCode::CONFLICT,
+            "original file changed during candidate execution; result withheld",
+        ));
+    }
+    if crate::project_stores::findings::get(&state.layout, &id)
+        .map_err(|e| err(StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?
+        .is_none_or(|f| serde_json::to_value(&f).ok() != serde_json::to_value(&finding).ok())
+    {
+        return Err(err(
+            StatusCode::CONFLICT,
+            "finding changed during candidate execution; outcome retained locally",
+        ));
+    }
+    finding.rounds.push(crate::audit::FindingRound{author:"insi".into(),text:format!("Isolated candidate execution: {}. Benchmark and original-tree application are not yet verified; waits for review, never auto-apply this candidate outcome.",result),at:now});
+    crate::audit::persist(
+        &state,
+        &mut finding,
+        now,
+        crate::audit::FindingStatus::NeedsHuman,
+    )
+    .await
+    .map_err(|e| err(StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?;
+    Ok(Json(
+        serde_json::json!({"status":result,"finding":finding.id,"candidate":candidate,"baseline":request.baseline,"finding_status":"needs_human"}),
+    ))
+}
+
+pub(crate) async fn candidate_status(
+    State(state): State<AppState>,
+    headers: HeaderMap,
+    axum::extract::Path(id): axum::extract::Path<String>,
+    Json(request): Json<CandidateRequest>,
+) -> Result<Json<serde_json::Value>, (StatusCode, Json<ErrorBody>)> {
+    let ctx = require_ctx_or_err(&headers, &state)?;
+    resolve_user_local(&ctx, "")?;
+    let finding = crate::project_stores::findings::get(&state.layout, &id)
+        .map_err(|e| err(StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?
+        .ok_or_else(|| err(StatusCode::NOT_FOUND, "finding not found"))?;
+    let (_, _, binding) = scope(&request, &finding).map_err(|e| err(StatusCode::CONFLICT, e))?;
+    let settings = state
+        .settings
+        .audit_settings()
+        .map_err(|e| err(StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?;
+    let binding = settings_key(&binding, &settings);
+    let rows = state
+        .settings
+        .owner_pending_scoped(&console_scope(&ctx, &state)?.scope)
+        .map_err(|e| err(StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?;
+    let row = rows
+        .iter()
+        .find(|r| {
+            r.token == request.approval_token
+                && r.dedup_key == binding
+                && r.project == request.project
+        })
+        .ok_or_else(|| err(StatusCode::FORBIDDEN, "approval scope does not match"))?;
+    let now = chrono::Utc::now().timestamp();
+    let status = if row.expires_at < now {
+        "expired"
+    } else if approved(row, &binding, &request.project, now) {
+        "approved"
+    } else if row.consumed {
+        "denied-or-revised"
+    } else {
+        "pending"
+    };
+    Ok(Json(serde_json::json!({"status":status})))
+}
+
+pub(crate) async fn candidate_report(
+    State(state): State<AppState>,
+    headers: HeaderMap,
+    axum::extract::Path(id): axum::extract::Path<String>,
+    Json(body): Json<serde_json::Value>,
+) -> Result<Json<serde_json::Value>, (StatusCode, Json<ErrorBody>)> {
+    let ctx = require_ctx_or_err(&headers, &state)?;
+    resolve_user_local(&ctx, "")?;
+    let token = body["approval_token"].as_str().unwrap_or("");
+    let rows = state
+        .settings
+        .owner_pending_scoped(&console_scope(&ctx, &state)?.scope)
+        .map_err(|e| err(StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?;
+    if !rows.iter().any(|r| {
+        r.token == token
+            && r.consumed
+            && r.verb == "approve"
+            && r.item_id.starts_with(&format!("insi:{id}:"))
+            && r.dedup_key.starts_with("insi-candidate:")
+    }) {
+        return Err(err(
+            StatusCode::FORBIDDEN,
+            "candidate approval record required",
+        ));
+    }
+    let mut finding = crate::project_stores::findings::get(&state.layout, &id)
+        .map_err(|e| err(StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?
+        .ok_or_else(|| err(StatusCode::NOT_FOUND, "finding not found"))?;
+    let status = body["status"]
+        .as_str()
+        .filter(|s| matches!(*s, "draft-pr" | "improved-local" | "kept" | "failed"))
+        .ok_or_else(|| err(StatusCode::BAD_REQUEST, "invalid outcome"))?;
+    let now = chrono::Utc::now().timestamp();
+    let note=format!("Insi candidate outcome: {status}. Evidence reference: {}. This is not proof of application to the original tree; finding status unchanged.",body["evidence"].as_str().unwrap_or("").chars().take(500).collect::<String>());
+    if !finding
+        .rounds
+        .iter()
+        .any(|r| r.author == "insi" && r.text == note)
+    {
+        finding.rounds.push(crate::audit::FindingRound {
+            author: "insi".into(),
+            text: note,
+            at: now,
+        });
+        let status = finding.status;
+        crate::audit::persist(&state, &mut finding, now, status)
+            .await
+            .map_err(|e| err(StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?;
+    }
+    Ok(Json(
+        serde_json::json!({"ok":true,"status":finding.status.as_str()}),
+    ))
+}
