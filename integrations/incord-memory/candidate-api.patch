+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn approval_is_scoped_and_cannot_be_a_recommendation() {
+        let mut row:crate::owner_web::StoredDecision=serde_json::from_value(serde_json::json!({"token":"t","item_id":"i","title":"candidate","detail":"","severity":3,"source":"forward","project":"/project","created_at":1,"expires_at":100,"consumed":true,"verb":"approve","dedup_key":"scope"})).unwrap();
+        assert!(approved(&row, "scope", "/project", 10));
+        assert!(!approved(&row, "different", "/project", 10));
+        assert!(!approved(&row, "scope", "/other", 10));
+        assert!(!approved(&row, "scope", "/project", 101));
+        row.consumed = false;
+        assert!(!approved(&row, "scope", "/project", 10));
+    }
+
+    #[test]
+    fn insi_candidate_scope_rejects_stale_sources_and_outside_targets() {
+        let scratch = std::env::var_os("INSI_TEST_ROOT")
+            .map(PathBuf::from)
+            .unwrap_or_else(|| Path::new(env!("CARGO_MANIFEST_DIR")).join(".incord/temp"));
+        std::fs::create_dir_all(&scratch).unwrap();
+        let root = scratch.join(format!(
+            "engine-candidate-{}-{}",
+            std::process::id(),
+            chrono::Utc::now().timestamp_nanos_opt().unwrap()
+        ));
+        std::fs::create_dir(&root).unwrap();
+        git_at(&root, &["init", "--quiet"]).unwrap();
+        git_at(&root, &["config", "user.name", "Test"]).unwrap();
+        git_at(&root, &["config", "user.email", "test@localhost"]).unwrap();
+        std::fs::write(root.join("source.txt"), "working").unwrap();
+        std::fs::write(root.join(".gitignore"), ".insi-work/\n").unwrap();
+        git_at(&root, &["add", "source.txt", ".gitignore"]).unwrap();
+        git_at(&root, &["commit", "--quiet", "-m", "baseline"]).unwrap();
+        let baseline = git_at(&root, &["rev-parse", "HEAD"]).unwrap();
+        std::fs::create_dir(root.join(".insi-work")).unwrap();
+        let candidate = root.join(".insi-work/candidate");
+        git_at(
+            &root,
+            &[
+                "clone",
+                "--quiet",
+                "--no-local",
+                root.to_str().unwrap(),
+                candidate.to_str().unwrap(),
+            ],
+        )
+        .unwrap();
+        let finding = crate::audit::Finding {
+            id: "insi-scope".into(),
+            file: root.join("source.txt").to_string_lossy().into_owned(),
+            scope: String::new(),
+            symbol: String::new(),
+            category: crate::audit::FindingCategory::Improvement,
+            severity: 2,
+            status: crate::audit::FindingStatus::Approved,
+            related: vec![],
+            rounds: vec![],
+            created_at: 100,
+            updated_at: 100,
+        };
+        let request = CandidateRequest {
+            project: root.to_string_lossy().into_owned(),
+            candidate: candidate.to_string_lossy().into_owned(),
+            baseline,
+            finding_updated_at: 100,
+            approval_token: String::new(),
+        };
+        assert!(scope(&request, &finding).is_ok());
+        // Exercise the actual execute route with a valid candidate but no grant.
+        let runtime = tokio::runtime::Runtime::new().unwrap();
+        runtime.block_on(async {
+            use axum::{body::Body, http::Request};
+            use tower::ServiceExt;
+            let (state, key) = crate::api::endpoint_tests::test_state();
+            crate::project_stores::findings::put(&state.layout, &finding).unwrap();
+            let app = crate::build_router(state, 256);
+            let response = app
+                .oneshot(
+                    Request::builder()
+                        .method("POST")
+                        .uri("/v1/memory/audit/findings/insi-scope/candidate/execute")
+                        .header("x-api-key", &key)
+                        .header("content-type", "application/json")
+                        .body(Body::from(serde_json::to_string(&request).unwrap()))
+                        .unwrap(),
+                )
+                .await
+                .unwrap();
+            assert_eq!(response.status(), StatusCode::FORBIDDEN);
+            assert!(!candidate.join(".git/insi-candidate.lock").exists());
+        });
+        let mut stale = request.clone();
+        stale.finding_updated_at = 99;
+        assert!(scope(&stale, &finding).is_err());
+        let mut outside = request.clone();
+        outside.candidate = root.to_string_lossy().into_owned();
+        assert!(scope(&outside, &finding).is_err());
+        std::fs::write(candidate.join("source.txt"), "changed").unwrap();
+        assert!(scope(&request, &finding).is_err());
+        assert_eq!(
+            std::fs::read_to_string(root.join("source.txt")).unwrap(),
+            "working"
+        );
+        std::fs::remove_dir_all(root).unwrap();
+    }
+
+    #[tokio::test]
+    async fn insi_candidate_http_routes_reject_unknown_findings_without_invoking_a_coder() {
+        use axum::{body::Body, http::Request};
+        use tower::ServiceExt;
+        let (state, key) = crate::api::endpoint_tests::test_state();
+        let app = crate::build_router(state, 256);
+        let request = serde_json::json!({"project":"/project","candidate":"/project/.insi-work/candidate","baseline":"0000000000000000000000000000000000000000","finding_updated_at":1});
+        for action in ["prepare", "execute", "status"] {
+            let response = app
+                .clone()
+                .oneshot(
+                    Request::builder()
+                        .method("POST")
+                        .uri(format!(
+                            "/v1/memory/audit/findings/unknown-insi/candidate/{action}"
+                        ))
+                        .header("x-api-key", &key)
+                        .header("content-type", "application/json")
+                        .body(Body::from(request.to_string()))
+                        .unwrap(),
+                )
+                .await
+                .unwrap();
+            assert_eq!(response.status(), StatusCode::NOT_FOUND);
+        }
+    }
+}
