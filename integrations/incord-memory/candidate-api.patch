+/// Reuse the audit coder and gate, but never resolve or edit the original finding.
+pub(crate) async fn apply_candidate(state:&AppState,settings:&AuditSettings,finding:&Finding,target:&std::path::Path,candidate:&std::path::Path)->anyhow::Result<String>{
+    anyhow::ensure!(settings.source==AuditSource::Cli,"candidate execution requires the configured local CLI coder");
+    let original=std::fs::read_to_string(target)?;
+    let issue=finding.rounds.first().map(|r|r.text.as_str()).unwrap_or_default();
+    let prompt=format!("Candidate file: {}\nApproved improvement: {}\nReturn only the requested find/replace. Do not edit files yourself or change benchmarks, tests, Git history or the original checkout.\n\n{}",target.display(),issue,original.chars().take(AUDIT_MAX_CHARS).collect::<String>());
+    let synth=make_synth(state,settings,&settings.coder_model);
+    let out=crate::project_stores::spend::generate_billed(&state.layout,crate::project_stores::spend::Payer::File(finding.file.clone()),crate::spend::source::AUTOFIX,synth.as_ref(),CODER_FIX_SYSTEM,&prompt).await?;
+    anyhow::ensure!(std::fs::read_to_string(target)?==original,"coder modified the candidate outside the gated edit path");
+    let edit=parse_fix(&out).ok_or_else(||anyhow::anyhow!("coder did not return a valid find/replace"))?;
+    let backup=candidate.join(".git/insi-candidate-original");
+    let (status,_)=apply_edit_gated_to(target.to_str().ok_or_else(||anyhow::anyhow!("non-UTF8 candidate"))?,&original,&edit,&settings.test_command,candidate.to_str().ok_or_else(||anyhow::anyhow!("non-UTF8 candidate"))?,backup.to_str().ok_or_else(||anyhow::anyhow!("non-UTF8 backup"))?).await?;
+    Ok(if status==FindingStatus::Resolved{"tested"}else{"reverted"}.into())
+}
